{
  "name": "everpeak-internal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute everpeak-internal-db --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute everpeak-internal-db --file=./schema.sql --local",
    "secrets": "echo 'Run: wrangler secret put SESSION_SECRET / GMAIL_USER / GMAIL_APP_PASSWORD / ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD'"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  },
  "dependencies": {
    "worker-mailer": "^0.3.7"
  }
}
